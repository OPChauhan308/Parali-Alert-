# Parali Alert Environment Configuration
APP_NAME="Parali Alert"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# NASA FIRMS API (Get a free map_key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Leave blank to automatically use FIRMS open public NRT CSV feeds for India / South Asia
FIRMS_MAP_KEY=""

# Open-Meteo Weather Forecast (Public API, no key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# Sentinel-2 STAC / AWS Open Data
# Public AWS Open Data STAC catalog by Element84
SENTINEL_STAC_URL="https://earth-search.aws.element84.com/v1"
SENTINEL_AWS_BUCKET="sentinel-cogs"
SENTINEL_AWS_REGION="us-west-2"

# AWS Cloud Integration (Optional - falls back to local data directory if not provided)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="ap-south-1"
S3_BUCKET_NAME="parali-alert-data-lake"
USE_LOCAL_S3_EMULATOR=true
LOCAL_STORAGE_PATH="./data/storage"

# Crop Calendar & Operations Parameters (Punjab Kharif -> Rabi Transition)
CROP_CALENDAR_HARVEST_START="09-25"
CROP_CALENDAR_HARVEST_PEAK="10-25"
CROP_CALENDAR_HARVEST_END="11-20"
WHEAT_SOWING_DEADLINE="11-15"

# Operational Preventability Parameters (Days)
OPTIMAL_PREVENTION_WINDOW_DAYS=5
MAX_PREVENTION_WINDOW_DAYS=10

# Air Quality Dispersion Proxy
ENABLE_AIR_QUALITY_CONSEQUENCE=true

# Demo & Data Mode: "live" (fetch external APIs) or "sample" (high-fidelity bundled offline dataset)
DATA_MODE="sample"
